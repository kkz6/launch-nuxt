# API Configuration. The /api prefix was dropped during the Go migration —
# the API serves at root now (/health, /login, /servers, …).
NUXT_PUBLIC_API_BASE=http://localhost:8000
NUXT_PUBLIC_WS_BASE=ws://localhost:8000

# Backend base used by Nitro server routes (/provision/:id, /webhooks/*,
# /deploy/*). They proxy bare-domain paths to the API. In dev it's the
# same host as PUBLIC_API_BASE since both run on localhost.
NUXT_BACKEND_BASE=http://localhost:8000
